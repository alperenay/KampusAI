{
  "name": "ders-asistani",
  "productName": "KampusAI",
  "version": "1.0.0",
  "description": "KampüsAI: ders programı, konu anlatımı, deneme takibi ve yapay zeka asistanı",
  "author": {
    "name": "KampüsAI",
    "email": "kampusai@users.noreply.github.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux deb AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dersasistani.app",
    "productName": "KampusAI",
    "copyright": "KampüsAI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "device.js",
      "build/icon.png",
      "app/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "KampusAI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KampüsAI",
      "uninstallDisplayName": "KampüsAI",
      "artifactName": "KampusAI-Kurulum-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "executableName": "kampusai",
      "maintainer": "KampüsAI <kampusai@users.noreply.github.com>",
      "vendor": "KampüsAI",
      "synopsis": "YKS çalışma uygulaması ve internetsiz yapay zekâ öğretmeni",
      "description": "KampüsAI; 9-12. sınıf konu anlatımları, TYT-AYT deneme takibi, yanlış defteri, öğrenme haritası ve bilgisayarda internetsiz çalışan bir yapay zekâ öğretmenini tek uygulamada toplar. Pardus için hazırlanmıştır.",
      "extraResources": [
        {
          "from": "../llama-linux",
          "to": "llama",
          "filter": [
            "**/*"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "KampüsAI",
          "GenericName": "YKS Çalışma Uygulaması",
          "Comment": "Konu anlatımı, deneme takibi ve internetsiz yapay zekâ öğretmeni",
          "Keywords": "YKS;TYT;AYT;ders;sınav;deneme;yapay zeka;eğitim;lise;",
          "StartupWMClass": "KampusAI",
          "Categories": "Education;"
        }
      }
    },
    "deb": {
      "artifactName": "KampusAI-${version}-pardus-amd64.${ext}",
      "packageName": "kampusai",
      "priority": "optional",
      "recommends": [
        "libvulkan1",
        "mesa-vulkan-drivers"
      ],
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libdrm2",
        "libgomp1"
      ]
    },
    "appImage": {
      "artifactName": "KampusAI-${version}-x86_64.${ext}"
    }
  },
  "homepage": "https://github.com/alperenay/KampusAI"
}
