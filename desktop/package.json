{
  "name": "ders-asistani",
  "productName": "KampusAI",
  "version": "1.0.0",
  "description": "KampüsAI: ders programı, konu anlatımı, deneme takibi ve yapay zeka asistanı",
  "author": "KampüsAI",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dersasistani.app",
    "productName": "KampusAI",
    "copyright": "KampüsAI",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "server.js", "device.js", "build/icon.png", "app/**/*"],
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "executableName": "KampusAI"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KampüsAI",
      "uninstallDisplayName": "KampüsAI",
      "artifactName": "KampusAI-Kurulum-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
